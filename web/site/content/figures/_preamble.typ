// Общий стиль научных схем тропы — по дизайн-системе сайта (site/assets/tokens.css).
// Раньше схемы были книжными: засечный Libertinus, приглушённая охра, тонкий штрих.
// Теперь язык плоской графики: гротеск, чистые акценты, уверенная линия.
// Этот файл — единственное место, где задан вид всех схем: правка здесь
// перерисовывает весь набор.
#import "@preview/cetz:0.4.2"

#set page(width: auto, height: auto, margin: 8pt, fill: rgb("#FBF8F1"))
#set text(font: "Golos Text", size: 10pt, fill: rgb("#22333C"))

// Палитра эталона. Имена оставлены прежними, чтобы не переписывать 83 схемы:
// каждая ссылается на INK / OLIVE / SAND / SUN, меняется только их содержимое.
#let INK   = rgb("#22333C")   // основной контур и текст
#let OLIVE = rgb("#2E9BD6")   // главный акцент: связи, оси, выделенные элементы
#let SAND  = rgb("#A9B7BF")   // вторичный тон: вспомогательные линии, заливки
#let SUN   = rgb("#F6BB2E")   // тёплый акцент: подсветка, «горячие» элементы

// Дополнительные акценты — для схем, где нужно развести несколько сущностей.
#let GRASS  = rgb("#4EA75D")
#let TERRA  = rgb("#E9863B")
#let VIOLET = rgb("#7A6FE0")
#let TEAL   = rgb("#23A79A")

// Линия толще прежних 0.6pt: в плоской графике тонкий штрих читается как блёклый.
#let LINE = 0.9pt
